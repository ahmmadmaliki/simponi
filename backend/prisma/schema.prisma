datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  noWa         String?
  email        String?
  receiveNotif Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TargetOpsen {
  id            Int      @id @default(autoincrement())
  jenisOpsen    String   // "PKB" or "BBNKB"
  tahun         Int
  targetRupiah  Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())
}

model RealisasiOpsen {
  id              Int      @id @default(autoincrement())
  kecamatan       String
  desaKelurahan   String
  tahun           Int
  bulan           String
  pkbPokok        Decimal  @db.Decimal(15, 2)
  opsenPkb        Decimal  @db.Decimal(15, 2)
  bbnkbPokok      Decimal  @db.Decimal(15, 2)
  opsenBbnkb      Decimal  @db.Decimal(15, 2)
  totalOpsen      Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
}

model Kegiatan {
  id               Int      @id @default(autoincrement())
  jenisKegiatan    String
  targetJumlah     Int
  realisasiJumlah  Int
  tahun            Int
  createdAt        DateTime @default(now())
}

model NotificationSetting {
  id          Int      @id @default(1)
  frequency   String   @default("weekly")
  dayOfWeek   Int      @default(6)
  dateOfMonth Int      @default(1)
  time        String   @default("08:00")
  cronString  String   @default("0 8 * * 6")
  updatedAt   DateTime @updatedAt
}

model DataPanen {
  id           Int      @id @default(autoincrement())
  kecamatan    String
  desa         String?
  bulan        String
  tahun        Int
  statusPanen  String   // e.g., "Tinggi", "Sedang", "Rendah"
  createdAt    DateTime @default(now())
}

model DataTunggakan {
  id             Int      @id @default(autoincrement())
  kecamatan      String
  desa           String?
  bulan          String
  tahun          Int
  rasioTunggakan Decimal  @db.Decimal(5, 2) // Percentage e.g. 45.50
  createdAt      DateTime @default(now())
}
